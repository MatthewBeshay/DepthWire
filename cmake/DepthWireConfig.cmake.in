@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/DepthWireTargets.cmake")

set(DepthWire_SUPPORTED_COMPONENTS
    Book
    Contracts
    Digest
    Engine
    Ha
    Market
    Order
    Pipeline
    Replay
    Risk
    Strategy
    Trace
    Wire
)

foreach(component IN LISTS DepthWire_FIND_COMPONENTS)
    if("${component}" IN_LIST DepthWire_SUPPORTED_COMPONENTS)
        set("DepthWire_${component}_FOUND" TRUE)
    else()
        set("DepthWire_${component}_FOUND" FALSE)
    endif()
endforeach()

check_required_components(DepthWire)
